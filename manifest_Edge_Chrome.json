{
  "manifest_version": 3,
  "name": "LLM Footprint Overlay (Minimal)",
  "version": "0.1.0",
  "description": "Einfaches Overlay zeigt pro ChatGPT-Antwort geschätzte Wh, gCO₂e und L Wasser – ohne Backend.",
  "permissions": ["storage"],
  "host_permissions": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
  "content_scripts": [{
    "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
